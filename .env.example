# Copy to .env.local for local development. Never commit real secrets.
DATABASE_URL=postgresql://localhost:5432/ai_business_manager_local
AUTH_SECRET=replace-with-a-long-random-secret
# Optional. Keep your AI provider key server-side; do not put it in public/app.js.
GEMINI_API_KEY=
# Optional: set true only if your PostgreSQL provider requires verified TLS.
PGSSL=false
